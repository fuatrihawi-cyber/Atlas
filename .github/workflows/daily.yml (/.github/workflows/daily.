name: atlas-daily
on:
  schedule:
    - cron: "10 0 * * *"
  workflow_dispatch:
permissions:
  contents: write
jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests pandas numpy
      - run: python atlas_update.py
      - run: |
          git config user.name "atlas-bot"
          git config user.email "atlas-bot@users.noreply.github.com"
          git add docs/data.json
          git commit -m "günlük güncelleme" || echo "değişiklik yok"
          git push
